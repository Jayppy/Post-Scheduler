# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YouTube OAuth 2.0 (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Meta Unified Login & Instagram Graph API (Meta Developer App)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

# Optional Meta Webhook verification (only needed if Instagram webhooks are enabled)
META_VERIFY_TOKEN=

# Optional server-side 32-byte hex/passphrase secret for encrypting stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

# Optional Paid / Subscribed Music Industry Data APIs (Marketing Content Studio)
# When absent, the app uses Gemini Google Search grounding and official reference sources.
CHARTMETRIC_API_KEY=
SOUNDCHARTS_API_KEY=
LUMINATE_API_KEY=

# Multi-Provider AI Architecture (Server-Side Secrets Only)
# Primary: Google Gemini (GEMINI_API_KEY above)
# Secondary Fallback #1: Groq (free-tier Llama models)
GROQ_API_KEY=
# Secondary Fallback #2: OpenRouter (verified free models only)
OPENROUTER_API_KEY=
# Optional Lightweight Provider (strictly classification, tagging, short summaries, simple extraction)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

