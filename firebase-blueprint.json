    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated studio operator profile isolating user workspaces and OAuth connection metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["operator"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "WorkspaceConnection": {
      "title": "WorkspaceConnection",
      "description": "Non-secret OAuth connection metadata per workspace and social platform (secrets stay server-side encrypted).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "platform": {
          "type": "string",
          "enum": ["instagram", "youtube"]
        },
        "connected": {
          "type": "boolean"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128
        },
        "accountName": {
          "type": "string",
          "maxLength": 160
        },
        "accountHandle": {
          "type": "string",
          "maxLength": 120
        },
        "tokenType": {
          "type": "string",
          "enum": ["SYSTEM_USER", "USER", "GOOGLE_OAUTH"]
        },
        "expiresAt": {
          "type": "number"
        },
        "lastError": {
          "type": "string",
          "maxLength": 600
        },
        "connectedAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "platform",
        "connected",
        "accountId",
        "accountName",
        "createdAt",
        "updatedAt"
      ]
    },
