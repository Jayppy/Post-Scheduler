{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated studio operator profile isolating user workspaces and OAuth connection metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["operator"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "WorkspaceConnection": {
      "title": "WorkspaceConnection",
      "description": "Non-secret OAuth connection metadata per workspace and social platform (secrets stay server-side encrypted).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "platform": {
          "type": "string",
          "enum": ["instagram", "youtube"]
        },
        "connected": {
          "type": "boolean"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128
        },
        "accountName": {
          "type": "string",
          "maxLength": 160
        },
        "accountHandle": {
          "type": "string",
          "maxLength": 120
        },
        "tokenType": {
          "type": "string",
          "enum": ["SYSTEM_USER", "USER", "GOOGLE_OAUTH"]
        },
        "expiresAt": {
          "type": "number"
        },
        "lastError": {
          "type": "string",
          "maxLength": 600
        },
        "connectedAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "platform",
        "connected",
        "accountId",
        "accountName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledJob": {
      "title": "ScheduledJob",
      "description": "Scheduled social publishing job metadata and execution state per workspace (media bytes excluded).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "platform": {
          "type": "string",
          "enum": ["youtube-shorts", "instagram-reel", "instagram-carousel", "instagram-feed"]
        },
        "caption": {
          "type": "string",
          "maxLength": 2500
        },
        "hashtags": {
          "type": "array",
          "description": "Bounded list of hashtag strings (max 30 items)."
        },
        "scheduledIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "youtubePrivacyStatus": {
          "type": "string",
          "enum": ["public", "unlisted", "private"]
        },
        "mediaCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "pending",
            "scheduled",
            "ready-to-send",
            "publishing",
            "published",
            "partially-published",
            "failed",
            "cancelled"
          ]
        },
        "attempts": {
          "type": "number"
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 64
        },
        "platformPostId": {
          "type": "string",
          "maxLength": 160
        },
        "resultUrl": {
          "type": "string",
          "maxLength": 500
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        },
        "igStatus": {
          "type": "string",
          "enum": ["scheduled", "ready-to-send", "publishing", "published", "failed", "cancelled"]
        },
        "igPostId": {
          "type": "string",
          "maxLength": 160
        },
        "igResultUrl": {
          "type": "string",
          "maxLength": 500
        },
        "igPublishedAt": {
          "type": "string",
          "maxLength": 64
        },
        "igError": {
          "type": "string",
          "maxLength": 1000
        },
        "ytStatus": {
          "type": "string",
          "enum": ["scheduled", "ready-to-send", "publishing", "published", "failed", "cancelled"]
        },
        "ytPostId": {
          "type": "string",
          "maxLength": 160
        },
        "ytResultUrl": {
          "type": "string",
          "maxLength": 500
        },
        "ytPublishedAt": {
          "type": "string",
          "maxLength": 64
        },
        "ytError": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "postId",
        "title",
        "platform",
        "caption",
        "hashtags",
        "scheduledIso",
        "mediaCount",
        "status",
        "attempts",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublishHistoryRecord": {
      "title": "PublishHistoryRecord",
      "description": "Append-only social publishing and failure audit history per workspace.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "jobId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "platform": {
          "type": "string",
          "enum": ["youtube-shorts", "instagram-reel", "instagram-carousel", "instagram-feed"]
        },
        "mode": {
          "type": "string",
          "enum": ["manual-send", "immediate", "scheduled", "retry"]
        },
        "status": {
          "type": "string",
          "enum": ["published", "failed"]
        },
        "platformPostId": {
          "type": "string",
          "maxLength": 160
        },
        "resultUrl": {
          "type": "string",
          "maxLength": 500
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "postId",
        "title",
        "platform",
        "mode",
        "status",
        "timestamp",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private operator profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/workspaceConnections/{connectionId}": {
      "schema": { "$ref": "#/entities/WorkspaceConnection" },
      "description": "Non-secret OAuth account connection metadata per workspace."
    },
    "/users/{userId}/scheduledJobs/{jobId}": {
      "schema": { "$ref": "#/entities/ScheduledJob" },
      "description": "Scheduled publishing job states and error logs per workspace."
    },
    "/users/{userId}/publishHistory/{historyId}": {
      "schema": { "$ref": "#/entities/PublishHistoryRecord" },
      "description": "Immutable publishing audit records and errors per workspace."
    }
  }
}
